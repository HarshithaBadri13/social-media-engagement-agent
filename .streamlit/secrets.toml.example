# Streamlit Cloud Deployment Secrets Template
# For Streamlit Community Cloud: Go to App Settings -> Secrets and paste these key-value pairs.
# For local development: Copy this file to .streamlit/secrets.toml and fill in your keys.

GROQ_API_KEY = "your_groq_api_key_here"
HINDSIGHT_API_KEY = "your_hindsight_api_key_here"
BANK_ID = "socialspark-agent"
